{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/report-schema.json",
  "title": "AURA Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "audited_at", "summary", "coverage", "ai_brand_twin", "findings", "checked_and_clean", "insufficient_evidence"],
  "properties": {
    "site": {"type": "string", "minLength": 1}, "audited_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["total_findings", "critical", "high", "medium", "low"], "properties": {"total_findings": {"type": "integer", "minimum": 0}, "critical": {"type": "integer", "minimum": 0}, "high": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0}, "low": {"type": "integer", "minimum": 0}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["pages_sampled", "pages_estimate", "robots_compliant", "elapsed_ms", "truncated"], "properties": {"pages_sampled": {"type": "integer", "minimum": 0}, "pages_estimate": {"type": "integer", "minimum": 0}, "robots_compliant": {"type": "boolean"}, "elapsed_ms": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}},
    "ai_brand_twin": {"$ref": "twin-schema.json"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "severity", "chain_link", "evidence", "mechanism", "why_it_matters", "impact_area", "affected", "suggested_action"], "properties": {"id": {"type": "string", "pattern": "^F-[0-9]{3,}$"}, "title": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low", "informational"]}, "chain_link": {"enum": ["reach", "read", "understand", "verify", "trust", "quote", "cite", "orient", "engage", "act", "retain"]}, "evidence": {"type": "string", "minLength": 1}, "mechanism": {"type": "string"}, "why_it_matters": {"type": "string"}, "impact_area": {"enum": ["discoverability", "engagement"]}, "affected": {"type": "object", "additionalProperties": false, "required": ["pages", "reach_share", "template"], "properties": {"pages": {"type": "integer", "minimum": 0}, "reach_share": {"type": "number", "minimum": 0, "maximum": 1}, "template": {"type": "string"}}}, "suggested_action": {"type": "object", "additionalProperties": false, "required": ["summary", "how", "owner", "priority", "validation"], "properties": {"summary": {"type": "string"}, "how": {"type": "array", "items": {"type": "string"}}, "owner": {"enum": ["content", "dev", "SEO"]}, "priority": {"enum": ["critical", "high", "medium", "low", "informational"]}, "validation": {"type": "string"}}}, "predicted_effect": {"type": "object", "additionalProperties": false, "required": ["signal", "expected", "observed_in_research"], "properties": {"signal": {"type": "string"}, "expected": {"type": "string"}, "observed_in_research": {"type": "string"}}}, "exploratory": {"type": "boolean"}}}},
    "checked_and_clean": {"type": "array", "items": {"type": "string"}}, "insufficient_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["check", "reason"], "properties": {"check": {"type": "string"}, "reason": {"type": "string"}}}}
  }
}
