{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/twin-schema.json",
  "title": "AURA AI Brand Twin",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "identity", "machine_readable", "facts", "quoteable_facts", "human_experience", "gaps", "check_execution"],
  "properties": {
    "site": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "one_liner", "what_they_do", "entity_ambiguity_risk", "evidence_refs"],
      "properties": {
        "name": {"type": ["string", "null"]}, "one_liner": {"type": ["string", "null"]},
        "what_they_do": {"type": "array", "items": {"type": "string"}},
        "entity_ambiguity_risk": {"enum": ["low", "medium", "high"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{3,}$"}}
      }
    },
    "machine_readable": {
      "type": "object", "additionalProperties": false,
      "required": ["pages_sampled", "pages_total_estimate", "coverage", "blocked_by_robots", "noindex_found", "render_gaps", "structured_data"],
      "properties": {
        "pages_sampled": {"type": "integer", "minimum": 0}, "pages_total_estimate": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "blocked_by_robots": {"type": "array", "items": {"type": "string"}}, "noindex_found": {"type": "array", "items": {"type": "string"}},
        "render_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "missing_facts", "confident"], "properties": {"url": {"type": "string"}, "missing_facts": {"type": "array", "items": {"type": "string"}}, "confident": {"type": "boolean"}}}},
        "structured_data": {"type": "object", "additionalProperties": false, "required": ["present", "valid", "types"], "properties": {"present": {"type": "integer", "minimum": 0}, "valid": {"type": "integer", "minimum": 0}, "types": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "value", "source_urls", "consistent", "contradicted_by", "quoteable", "check_id"], "properties": {"key": {"type": "string"}, "value": {"type": "string"}, "source_urls": {"type": "array", "items": {"type": "string"}}, "consistent": {"type": "boolean"}, "contradicted_by": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "value"], "properties": {"url": {"type": "string"}, "value": {"type": "string"}}}}, "quoteable": {"type": "boolean"}, "check_id": {"type": "string", "pattern": "^(CG|EF|TF|EG)-[0-9]{3}$"}}}},
    "quoteable_facts": {"type": "integer", "minimum": 0},
    "human_experience": {"type": "object", "additionalProperties": false, "required": ["above_fold_states_offering", "primary_cta_found", "cta_count", "heading_hierarchy_ok", "h1_title_mismatch"], "properties": {"above_fold_states_offering": {"type": "boolean"}, "primary_cta_found": {"type": "boolean"}, "cta_count": {"type": "integer", "minimum": 0}, "heading_hierarchy_ok": {"type": "boolean"}, "h1_title_mismatch": {"type": "boolean"}}},
    "gaps": {"type": "object", "additionalProperties": false, "required": ["confidently_known", "ambiguous", "contradicted"], "properties": {"confidently_known": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact", "source_url", "check_id"], "properties": {"fact": {"type": "string"}, "source_url": {"type": "string"}, "check_id": {"type": "string", "pattern": "^(CG|EF|TF|EG)-[0-9]{3}$"}}}}, "ambiguous": {"type": "array", "items": {"type": "string"}}, "contradicted": {"type": "array", "items": {"type": "string"}}}},
    "check_execution": {"type": "object", "additionalProperties": false, "required": ["checked_and_clean", "insufficient_evidence"], "properties": {"checked_and_clean": {"type": "array", "items": {"type": "string"}}, "insufficient_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["check", "reason"], "properties": {"check": {"type": "string"}, "reason": {"type": "string"}}}}}}
  }
}
